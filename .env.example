# Required. Get one at https://platform.claude.com (API keys). Also powers web research.
ANTHROPIC_API_KEY=

# Optional. Duffel access token. With it, flight search uses Duffel; a token starting
# duffel_test_ returns fictional test offers. Stay search also uses Duffel if Stays is
# enabled on the account, and otherwise falls back to sample data.
DUFFEL_ACCESS_TOKEN=

# Optional. When set, every page and API asks for this code first.
# Set it on any hosted copy so strangers cannot spend your API credit.
SAFAR_ACCESS_CODE=

# Optional overrides
# SAFAR_MODEL=claude-sonnet-5-5
# SAFAR_EFFORT=low
# Set to 1 to force every travel source to its built-in mock (no network calls)
# SAFAR_OFFLINE=1
# Set to mock to use offline sample notes instead of live web research
# SAFAR_RESEARCH=mock

# SQLite database file, relative to the prisma folder
DATABASE_URL="file:./dev.db"
